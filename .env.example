# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# See docs/MythWeaver-Dev-Spec.md §3 (models), §5.2 (embeddings), §4.4 (budget), §13 (data handling).

# --- LLM (reasoning brain) ---
# Anthropic Claude. Routed Opus/Sonnet internally (spec §3).
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings (RAG, optional) ---
# Enables SEMANTIC rules retrieval. With a key set + a cached vectors file
# (scripts/embed-corpus.mjs), the server uses an in-memory vector retriever — no DB
# needed. Without a key it falls back to offline keyword (BM25). A DIFFERENT vendor
# from Anthropic: corpus text is sent to it (spec §5.2/§13).
OPENAI_API_KEY=        # text-embedding-3-large @ 1024 dims (recommended for the in-memory path)
VOYAGE_API_KEY=        # voyage-3-large @ 1024 dims (used by the pgvector path)

# --- Database (Postgres + pgvector) ---
POSTGRES_PASSWORD=mythweaver
DATABASE_URL=postgres://mythweaver:mythweaver@localhost:5432/mythweaver

# --- Per-session budget cap (spec §4.4) ---
# USD per session. Empty or 0 = off (the v1 default). Soft-warn at 80%, hard-stop at 100%.
MYTHWEAVER_SESSION_BUDGET_USD=

# --- Server ---
# Backend port. The web app calls the backend at http://localhost:6984 by default
# (apps/web/app/*), so keep 6984 in local dev (or set NEXT_PUBLIC_SERVER_URL to match).
PORT=6984
# Bind address. Defaults to 127.0.0.1 (localhost-only). Containers set 0.0.0.0.
HOST=127.0.0.1
# Optional shared-secret. If set, all routes except /health require
# `Authorization: Bearer <token>`. REQUIRED when HOST is 0.0.0.0 / exposed.
MYTHWEAVER_API_TOKEN=
# Optional: point the DM persona at a different playbook file for A/B testing.
MYTHWEAVER_PLAYBOOK_PATH=

# --- Observability / tracing (optional) ---
# Default with no keys: local JSONL at ./traces.jsonl (override with MYTHWEAVER_TRACE_FILE).
# Set Langfuse keys to ship traces to Langfuse (cloud or self-hosted) instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=        # e.g. https://cloud.langfuse.com or your self-hosted URL
# MYTHWEAVER_TRACE_FILE=./traces.jsonl
